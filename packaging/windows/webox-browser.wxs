<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v7 installer definition for WebOX Browser.
  Built in CI - see the "Build .msi (Windows)" step in .github/workflows/build.yml.
  The PowerShell harvester generates AppFiles.wxs from the staging directory at build time.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
    Name="WebOX Browser"
    Manufacturer="Jesse Koldewijn"
    Version="$(var.Version)"
    UpgradeCode="7B3E8F2A-4C1D-4E9F-B562-0D8A3F7C2E15"
    Scope="perMachine">

    <SummaryInformation
      Description="WebOX Browser — a web browser built with Rust and CEF" />

    <!-- Remove older versions on upgrade; block downgrades with a message -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of WebOX Browser is already installed." />

    <!-- Embed all files into a single embedded CAB -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Standard install-dir dialog -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- Install into %ProgramFiles%\WebOX Browser -->
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="WebOX Browser" />
    </StandardDirectory>

    <!-- Start Menu shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="WebOX Browser" />
    </StandardDirectory>

    <ComponentGroup Id="Shortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
        <Shortcut
          Id="AppStartMenuShortcut"
          Name="WebOX Browser"
          Description="A web browser built with Rust and CEF"
          Target="[INSTALLFOLDER]webox-browser-app.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="CleanUpShortCut"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />
        <!-- Key path: registry value that tracks whether this component is installed -->
        <RegistryValue
          Root="HKCU"
          Key="Software\WeboxBrowser"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="WebOX Browser" Level="1">
      <!-- AppFiles ComponentGroup is generated at build time by harvesting staging\ -->
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

  </Package>
</Wix>
