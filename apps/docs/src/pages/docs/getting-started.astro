---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="webox | getting started">
  <section class="panel doc-content">
    <div class="eyebrow">Getting started</div>
    <h1>Run the current workspace prototype</h1>
    <ol>
      <li>Run <code>bun install</code> to install Astro, SolidJS, and shared workspace packages.</li>
      <li>Run <code>cargo test</code> to execute Rust unit and smoke tests.</li>
      <li>Run <code>cargo run -p webox-browser-app</code> to boot the browser shell prototype.</li>
      <li>Run <code>bun run docs:dev</code> to view the Astro docs and marketing site.</li>
    </ol>
  </section>
</BaseLayout>
